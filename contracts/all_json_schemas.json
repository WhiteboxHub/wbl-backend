{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIPrep Master JSON Contracts Suite",
  "description": "The single consolidated JSON file containing every payload signature across API endpoints, Orchestrator boundaries, Core Engines, and LLM evaluation outputs.",
  "definitions": {

    "=== SECTION 1: API ENDPOINT REQUEST & RESPONSE CONTRACTS ===": {},

    "UI_to_API_Create_Assessment": {
      "type": "object",
      "description": "[API ROUTE CONTRACT] POST /api/aiprep/assessments — Request body signature.",
      "properties": {
        "candidate_id": { "type": "integer" },
        "assessment_type": {
          "type": "string",
          "enum": ["INTRO", "JD_INTRO", "RECRUITER", "HIRING_MANAGER", "SYSTEM_DESIGN", "TECHNICAL"]
        },
        "media_type": {
          "type": "string",
          "enum": ["VIDEO", "AUDIO"]
        },
        "job_description": { "type": ["string", "null"] }
      },
      "required": ["candidate_id", "assessment_type", "media_type"]
    },

    "UI_to_API_Local_Media_Upload": {
      "type": "object",
      "description": "[API ROUTE CONTRACT] Multipart form-data payload uploading binary video/audio blob to local server disk storage.",
      "properties": {
        "assessment_id": { "type": "integer" },
        "media_type": { "type": "string", "enum": ["VIDEO", "AUDIO"] }
      },
      "required": ["assessment_id", "media_type"]
    },

    "UI_to_API_Submit_Data": {
      "type": "object",
      "description": "[API ROUTE CONTRACT] POST /api/aiprep/assessments/{id}/data — Submits questions, transcript, audio & video telemetry.",
      "properties": {
        "questions": { "type": "array", "items": { "type": "object" } },
        "transcript": { "type": "object" },
        "audio_telemetry": { "type": "object" },
        "video_telemetry": { "type": "object" }
      },
      "required": ["questions", "transcript", "audio_telemetry", "video_telemetry"]
    },

    "API_Update_Media_URL": {
      "type": "object",
      "description": "[API ROUTE CONTRACT] PATCH /api/aiprep/assessments/{id}/media — Updates youtube_url.",
      "properties": {
        "youtube_url": { "type": "string" }
      },
      "required": ["youtube_url"]
    },

    "API_Assessment_List_Response": {
      "type": "object",
      "description": "[API ROUTE CONTRACT] GET /api/aiprep/assessments?candidate_id={id} — Paginated list response.",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "assessment_type": { "type": "string" },
              "media_type": { "type": "string" },
              "status": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "total": { "type": "integer" }
      },
      "required": ["items", "total"]
    },

    "API_Question_Create_Request": {
      "type": "object",
      "description": "[API ROUTE CONTRACT] POST /api/aiprep/questions — Admin question creation payload.",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["INTRO", "JD_INTRO", "RECRUITER", "HIRING_MANAGER", "SYSTEM_DESIGN", "TECHNICAL"]
        },
        "sub_category": { "type": ["string", "null"] },
        "difficulty_level": {
          "type": "string",
          "enum": ["EASY", "MEDIUM", "HARD", "EXPERT"]
        },
        "question_text": { "type": "string" },
        "is_active": { "type": "boolean" }
      },
      "required": ["category", "difficulty_level", "question_text"]
    },

    "API_Question_Update_Request": {
      "type": "object",
      "description": "[API ROUTE CONTRACT] PATCH /api/aiprep/questions/{id} — Admin question update payload.",
      "properties": {
        "sub_category": { "type": ["string", "null"] },
        "difficulty_level": { "type": "string" },
        "question_text": { "type": "string" },
        "is_active": { "type": "boolean" }
      }
    },

    "API_Question_Response": {
      "type": "object",
      "description": "[API ROUTE CONTRACT] Admin question response schema.",
      "properties": {
        "id": { "type": "integer" },
        "category": { "type": "string" },
        "sub_category": { "type": ["string", "null"] },
        "difficulty_level": { "type": "string" },
        "question_text": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "category", "difficulty_level", "question_text", "is_active", "created_at"]
    },

    "=== SECTION 2: CORE ENGINE 1 — ASSESSMENT ENGINE CONTRACT STARTS HERE ===": {},

    "AIPrep_Assessment_Engine_Contract": {
      "contract_name": "ai_prep_assessment_engine_contract",
      "version": "1.0.0",
      "purpose": "[CORE ENGINE 1: ASSESSMENT ENGINE] Pure workflow state machine contract (START, SUBMIT, CANCEL rules). ZERO DB / ZERO Network Calls.",
      "architecture": {
        "request_flow": [
          "UI",
          "API",
          "Assessment Orchestrator",
          "Assessment Engine",
          "Assessment Orchestrator",
          "API",
          "UI"
        ],
        "principle": "The Assessment Orchestrator handles external interactions and persistence. The Assessment Engine validates input, applies assessment business rules, and returns the resulting assessment state."
      },
      "assessment_engine": {
        "responsibilities": [
          "Validate assessment input",
          "Validate the current assessment state",
          "Apply assessment business rules",
          "Validate assessment start conditions",
          "Validate assessment submission conditions",
          "Validate cancellation conditions",
          "Validate testing results provided to the engine",
          "Validate question and session state",
          "Apply assessment status transitions",
          "Return the resulting assessment state",
          "Return validation or business-rule errors"
        ],
        "does_not_do": [
          "Access the database",
          "Call APIs",
          "Call LLMs",
          "Call STT services",
          "Call external services",
          "Perform transcript generation",
          "Perform audio or video analysis",
          "Persist assessment data",
          "Generate the final assessment report"
        ]
      },
      "status": {
        "type": "string",
        "allowed_values": ["IN_PROGRESS", "EVALUATING", "COMPLETED", "FAILED"]
      },
      "operation": {
        "type": "string",
        "allowed_values": ["START", "SUBMIT", "CANCEL"]
      },
      "input_contract": {
        "assessment": {
          "assessment_id": { "type": "integer", "required": true },
          "candidate_id": { "type": "integer", "required": true },
          "assessment_type": {
            "type": "string",
            "required": true,
            "allowed_values": ["INTRO", "JD_INTRO", "RECRUITER", "HIRING_MANAGER", "SYSTEM_DESIGN", "TECHNICAL"]
          },
          "media_type": { "type": "string", "required": true, "allowed_values": ["AUDIO", "VIDEO"] },
          "status": {
            "type": "string",
            "required": true,
            "allowed_values": ["IN_PROGRESS", "EVALUATING", "COMPLETED", "FAILED"]
          },
          "job_description": { "type": "string", "required": false }
        },
        "operation": {
          "type": "string",
          "required": true,
          "allowed_values": ["START", "SUBMIT", "CANCEL"]
        },
        "testing": {
          "type": "object",
          "required": false,
          "properties": {
            "completed": { "type": "boolean" },
            "passed": { "type": "boolean" }
          }
        },
        "session": {
          "type": "object",
          "required": false,
          "properties": {
            "started_at": { "type": "string", "format": "datetime" },
            "completed_at": { "type": "string", "format": "datetime" }
          }
        },
        "question": {
          "type": "object",
          "required": false,
          "properties": {
            "question_id": { "type": "integer" },
            "question_number": { "type": "integer" }
          }
        }
      },
      "output_contract": {
        "success": { "type": "boolean", "required": true },
        "assessment": {
          "assessment_id": { "type": "integer", "required": true },
          "status": {
            "type": "string",
            "required": true,
            "allowed_values": ["IN_PROGRESS", "EVALUATING", "COMPLETED", "FAILED"]
          }
        },
        "error": {
          "type": "object",
          "required": false,
          "properties": {
            "code": { "type": "string", "required": true },
            "message": { "type": "string", "required": true }
          }
        }
      },
      "status_transitions": {
        "START": { "from": ["IN_PROGRESS"], "to": "IN_PROGRESS" },
        "SUBMIT": { "from": ["IN_PROGRESS"], "to": "EVALUATING" },
        "CANCEL": { "from": ["IN_PROGRESS"], "to": "FAILED" },
        "EVALUATING": { "success": "COMPLETED", "failure": "FAILED" }
      },
      "business_rules": {
        "status_rules": [
          "An assessment must be IN_PROGRESS before it can be submitted.",
          "Submission changes the assessment status from IN_PROGRESS to EVALUATING.",
          "Evaluation completion changes the status from EVALUATING to COMPLETED.",
          "Evaluation failure changes the status from EVALUATING to FAILED.",
          "A completed assessment cannot be submitted again.",
          "A failed assessment cannot be submitted again.",
          "An assessment cancellation is allowed only while the assessment is IN_PROGRESS."
        ],
        "question_rules": [
          "Questions are selected according to the assessment question-selection rules.",
          "A question must not be repeated until all eligible questions in the applicable category have been used.",
          "Question retrieval and persistence are handled by the Assessment Orchestrator."
        ]
      }
    },

    "=== SECTION 3: CORE ENGINE 2 — AUDIO ENGINE CONTRACTS START HERE ===": {},

    "Orchestrator_to_Audio_Engine": {
      "type": "object",
      "description": "[CORE ENGINE 2: AUDIO ENGINE] Input payload passed from Orchestrator into Audio Engine.",
      "properties": {
        "audio_telemetry": { "type": "object" }
      },
      "required": ["audio_telemetry"]
    },

    "Audio_Engine_Output": {
      "type": "object",
      "description": "[CORE ENGINE 2: AUDIO ENGINE] Formatted audio context string output returned to Orchestrator.",
      "properties": {
        "audio_context": { "type": "string" }
      },
      "required": ["audio_context"]
    },

    "=== SECTION 4: CORE ENGINE 3 — VIDEO PROCESSOR ENGINE CONTRACTS START HERE ===": {},

    "Orchestrator_to_Video_Engine": {
      "type": "object",
      "description": "[CORE ENGINE 3: VIDEO PROCESSOR ENGINE] Input payload passed from Orchestrator into Video Processor Engine.",
      "properties": {
        "video_telemetry": { "type": "object" }
      },
      "required": ["video_telemetry"]
    },

    "Video_Engine_Output": {
      "type": "object",
      "description": "[CORE ENGINE 3: VIDEO PROCESSOR ENGINE] Formatted video context string output returned to Orchestrator.",
      "properties": {
        "video_context": { "type": "string" }
      },
      "required": ["video_context"]
    },

    "=== SECTION 5: CORE ENGINE 4 — LLM EVALUATION ENGINE CONTRACTS START HERE ===": {},

    "Orchestrator_to_Eval_Engine": {
      "type": "object",
      "description": "[CORE ENGINE 4: LLM EVALUATION ENGINE] Combined context payload passed into Eval Engine.",
      "properties": {
        "audio_context": { "type": "string" },
        "video_context": { "type": "string" },
        "qa_context": { "type": "string" }
      },
      "required": ["audio_context", "qa_context"]
    },

    "Eval_Engine_Prompt_Output": {
      "type": "object",
      "description": "[CORE ENGINE 4: LLM EVALUATION ENGINE] System and user prompt strings output for LLM call.",
      "properties": {
        "system_prompt": { "type": "string" },
        "user_prompt": { "type": "string" },
        "response_format": { "type": "string" }
      },
      "required": ["system_prompt", "user_prompt"]
    },

    "=== SECTION 6: CORE ENGINE 5 — SCORES ENGINE CONTRACTS START HERE ===": {},

    "Orchestrator_to_Scores_Engine": {
      "type": "object",
      "description": "[CORE ENGINE 5: SCORES ENGINE] Unverified raw LLM JSON string input payload passed into Scores Engine.",
      "properties": {
        "raw_llm_json_string": { "type": "string" }
      },
      "required": ["raw_llm_json_string"]
    },

    "Scores_Engine_Output": {
      "type": "object",
      "description": "[CORE ENGINE 5: SCORES ENGINE] Validated report output (audio_evaluation, video_evaluation, transcript_evaluation).",
      "properties": {
        "is_valid": { "type": "boolean" },
        "parsed_report": {
          "type": "object",
          "properties": {
            "audio_evaluation": { "type": "object" },
            "video_evaluation": { "type": "object" },
            "transcript_evaluation": { "type": "object" }
          },
          "required": ["audio_evaluation", "video_evaluation", "transcript_evaluation"]
        }
      },
      "required": ["is_valid", "parsed_report"]
    },

    "=== SECTION 7: MASTER ENGINE CONTRACT (BE3_Master_Engine_Contract) STARTS HERE ===": {},

    "BE3_Master_Engine_Contract": {
