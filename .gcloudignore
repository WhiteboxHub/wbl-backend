# .gcloudignore — excludes files from Cloud Build source upload
# (mirrors .dockerignore but for gcloud run deploy --source .)

.gcloudignore
.git
.gitignore

__pycache__/
*.pyc
*.pyo
*.pyd

.env
.env.*
*.db
.DS_Store

# Local virtual environment — never send to Cloud Build
myvenv/
venv/
.venv/

# Service account keys and GHA credentials — must never be uploaded
*.json
*creds*
*credentials*
gha-creds-*.json

# Test and dev artifacts
tests/
pytest_cache/
.coverage
coverage.xml
test_results.txt

# Pre-commit
.pre-commit-config.yaml
